# Ambiente de PRODUÇÃO (raiz do monorepo).
# Copie e preencha:
#   cp .env.example .env
#
# Uso:
#   docker compose -f docker-compose.prod.yml up -d --build
#   bash deploy/host/setup-vekta-host.sh --migrate   # interface no host (systemd)
#
# O systemd vekta-ai carrega este arquivo (EnvironmentFile) + opcionalmente
# "Vekta AI/interface/.env". Nunca commite o .env.

# --- Domínios / URLs públicas ---
# Interface no host (nginx → systemd)
# VEKTA_FRAME_ANCESTORS não é mais necessário (CRM Frappe removido)

# --- Interface Vekta (login web) ---
VEKTA_AI_USUARIO=admin
VEKTA_AI_SENHA=troque-esta-senha
VEKTA_AI_SESSION_SECRET=gere-um-segredo-longo-e-aleatorio
# VEKTA_AI_SENHA_HASH=
VEKTA_AI_COOKIE_SECURE=true
VEKTA_AI_PERMISSION_MODE=bypassPermissions

# --- Claude CLI ---
# Roda no host como o usuário do systemd (HOME desse usuário → ~/.claude).
# Auth: como esse usuário, rode `claude` uma vez (ou copie ~/.claude do volume antigo).

# --- OpenRouter (campanhas WhatsApp / agent de atendimento no backend) ---
# Obtenha a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openai/gpt-4o-mini

# --- Google Calendar (agendamento pelo agent WhatsApp; também usado na interface) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# Horários oferecidos pela tool listar_horarios_disponiveis
GOOGLE_CALENDAR_BUSINESS_START=9
GOOGLE_CALENDAR_BUSINESS_END=18
GOOGLE_CALENDAR_SLOT_MINUTES=60

# --- Backend Laravel (CRM próprio — Docker) ---
# Postgres do compose prod (senha aplicada na 1ª criação do volume postgres-data).
POSTGRES_DB=vekta_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-forte
# Interface no host (systemd) → API no loopback do Docker
BACKEND_URL=http://127.0.0.1:8080
# Token Sanctum impresso no primeiro migrate --seed (AdminUserSeeder):
#   docker compose -f docker-compose.prod.yml exec backend php artisan db:seed --class=AdminUserSeeder --force
BACKEND_API_TOKEN=

# --- Opcional ---
# OPENAI_API_KEY=sk-
