APP_NAME="Vekta Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# Base URL da Whatsapp-api (Basic Auth por usuário CRM)
# Em Docker prod o compose sobrescreve para http://wwebjs:3000
WHATSAPP_API_URL=http://localhost:3000
OPENROUTER_API_KEY=
# Modelo default do agent WhatsApp (sobrescrito por agents.model)
OPENROUTER_AGENT_MODEL=openai/gpt-4o-mini

# Google Calendar (tool criar_agendamento do agent WhatsApp)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# Horários oferecidos pela tool listar_horarios_disponiveis
GOOGLE_CALENDAR_BUSINESS_START=9
GOOGLE_CALENDAR_BUSINESS_END=18
GOOGLE_CALENDAR_SLOT_MINUTES=60

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vekta_ai
DB_USERNAME=postgres
DB_PASSWORD=

# Docker prod: copie este arquivo para backend/.env, gere APP_KEY
# (php artisan key:generate --show) e use a mesma POSTGRES_PASSWORD do .env da raiz.
# O compose sobrescreve DB_HOST=postgres, APP_URL=http://backend:8000 e WHATSAPP_API_URL.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
