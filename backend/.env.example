# Copie: cp .env.example .env   (não commite o .env)
#
# PRODUÇÃO (Docker — docker-compose.prod.yml já lê este arquivo):
#   Preencha APP_KEY e DB_PASSWORD. O resto já está no valor de prod.
#   APP_KEY: php artisan key:generate
#            (ou: php artisan key:generate --show  e cole abaixo)
#   DB_PASSWORD: o mesmo valor de POSTGRES_PASSWORD no .env da raiz do monorepo.
#
#   O compose ainda sobrescreve no container (não precisa mudar aqui):
#     APP_ENV, APP_DEBUG, APP_URL, DB_HOST, DB_*, WHATSAPP_API_URL,
#     QUEUE_CONNECTION, REDIS_HOST, OPENROUTER_API_KEY, GOOGLE_*
#
# DESENVOLVIMENTO (php artisan serve no host):
#   APP_ENV=local
#   APP_DEBUG=true
#   APP_URL=http://localhost:8000
#   DB_HOST=127.0.0.1
#   WHATSAPP_API_URL=http://localhost:3000
#   QUEUE_CONNECTION=database
#   REDIS_HOST=127.0.0.1

APP_NAME="Clínica Sorria Bauru"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://backend:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Banco (prod: serviço postgres na rede clinica-network) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vekta_ai
DB_USERNAME=postgres
DB_PASSWORD=

# --- WhatsApp API (prod: serviço wwebjs) ---
WHATSAPP_API_URL=http://wwebjs:3000
WHATSAPP_MEDIA_RETENTION_DAYS=90
WHATSAPP_MEDIA_MAX_MB_PER_CLINIC=2048

# --- OpenRouter (agent WhatsApp). Em prod o compose também lê do .env da raiz. ---
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENROUTER_TRANSCRIPTION_LANGUAGE=pt
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_BUSINESS_START=9
GOOGLE_CALENDAR_BUSINESS_END=18
GOOGLE_CALENDAR_SLOT_MINUTES=60

# --- Fila / cache / sessão ---
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=clinica-
REDIS_QUEUE_RETRY_AFTER=21700

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
