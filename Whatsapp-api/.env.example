# Configurações de Autenticação Basic Auth
# Adicione suas credenciais aqui
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=sua_senha_segura

# Basic Auth nos webhooks enviados para aplicações externas (Laravel, etc.)
# Se username e password estiverem definidos, todos os POSTs de webhook incluirão Authorization: Basic
# Deixe vazio para enviar webhooks sem autenticação
WEBHOOK_BASIC_AUTH_USERNAME=
WEBHOOK_BASIC_AUTH_PASSWORD=

# Configurações do servidor
PORT=3000
NODE_ENV=development

# Configurações do MongoDB
# URL de conexão com o MongoDB (padrão: localhost)
# Com Docker Compose, MONGODB_URI é definida no docker-compose.yml (serviço mongo)
MONGODB_URI=mongodb://localhost:27017/whatsapp-sessions

# Configurações de Restauração Automática de Sessões
# Habilita/desabilita a restauração automática de sessões na inicialização
# true = habilitado (padrão), false = desabilitado
AUTO_RESTORE_SESSIONS=true

# Delay em milissegundos antes de iniciar a restauração de sessões
# Útil para aguardar o servidor estabilizar (padrão: 5000ms = 5 segundos)
RESTORE_DELAY=5000

# Outras configurações do projeto podem ser adicionadas aqui
