# Copie para .env e preencha. Não commite o .env.

# Auth
VEKTA_AI_USUARIO=admin
VEKTA_AI_SENHA=troque-esta-senha
VEKTA_AI_SESSION_SECRET=

# Features (true/false)
VEKTA_FEATURE_INSTAGRAM=true
VEKTA_FEATURE_CRM=true
VEKTA_FEATURE_CAMPANHAS=false
VEKTA_FEATURE_FINANCEIRO=false
VEKTA_FEATURE_SITE=true
VEKTA_FEATURE_TRAFEGO=true
VEKTA_FEATURE_AGENDA=true

# Site — pasta com index.html (relativa à raiz do Vekta)
VEKTA_SITE_DIR=marketing/sites/portfolio-1/web/dist

# Backend Laravel (CRM) — token de serviço impresso pelo seeder (backend: php artisan migrate --seed)
# Em prod (Docker): BACKEND_URL=http://127.0.0.1:8180
BACKEND_URL=http://localhost:8000
BACKEND_API_TOKEN=

# Instagram
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Meta Ads (Marketing API)
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXX
# META_ADS_GRAPH_HOST=https://graph.facebook.com
# META_ADS_GRAPH_VERSION=v25.0

# Google OAuth (um Client do Cloud Console — compartilhado por Ads e Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads API (refresh token + developer token; sem tela de login na UI)
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # MCC, se acessar via conta gerente
# GOOGLE_ADS_API_VERSION=v21

# Google Calendar API (refresh token; scope calendar; sem tela de login na UI)
GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_CALENDAR_ID=primary