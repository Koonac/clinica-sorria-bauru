# Copie: cp .env.example .env   (não commite o .env)
#
# PRODUÇÃO (Docker — docker-compose.prod.yml lê este arquivo):
#   Preencha BASIC_AUTH_USERNAME e BASIC_AUTH_PASSWORD.
#   Use as mesmas credenciais no CRM (conexão WhatsApp da clínica).
#   O compose sobrescreve PORT=3000 e MONGODB_URI=mongodb://mongo:27017/whatsapp-sessions
#
# DESENVOLVIMENTO (npm run dev no host, Mongo local):
#   NODE_ENV=development
#   MONGODB_URI=mongodb://localhost:27017/whatsapp-sessions

BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=troque-esta-senha-forte

# Basic Auth nos webhooks enviados ao Laravel. Deixe vazio: o CRM autentica por ?token=
WEBHOOK_BASIC_AUTH_USERNAME=
WEBHOOK_BASIC_AUTH_PASSWORD=

PORT=3000
NODE_ENV=production

MONGODB_URI=mongodb://mongo:27017/whatsapp-sessions

AUTO_RESTORE_SESSIONS=true
RESTORE_DELAY=5000
